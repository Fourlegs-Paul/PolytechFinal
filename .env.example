# 실제 값은 .env.local에 입력하고 이 파일에는 복사 위치만 공유합니다.

# Supabase > Connect 화면에서 각각 복사
NEXT_PUBLIC_SUPABASE_URL=https://복사한-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=복사한_sb_publishable_키

# Naver Developers > 내 애플리케이션 > 오늘뭐먹지에서 복사
# 두 값 모두 서버 Route 전용이며 NEXT_PUBLIC_을 붙이지 않습니다.
NAVER_CLIENT_ID=복사한_Client_ID
NAVER_CLIENT_SECRET=복사한_Client_Secret
